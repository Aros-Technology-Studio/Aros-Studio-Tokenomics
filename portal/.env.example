# Portal edge (copy to portal/backend/.env or export in shell)
# Local demo — DO NOT use in production

PORTAL_PORT=3100
CORE_API_URL=http://127.0.0.1:3000
PORTAL_CORE_HANDOFF=true
AST_ALLOW_DEMO=1

# Edge process index (survives edge restart; not NodeChain SoT)
AST_EDGE_STORE_PATH=../../data/edge-processes.json

# Real institutions (preferred: file under data/, gitignored)
# Generate: bash scripts/setup-institution-secrets.sh --id PILOT --name "Pilot Institution"
# AST_INSTITUTION_SECRETS_FILE=../../data/institution-secrets.json
# AST_ALLOW_DEMO=0
#
# Or inline JSON (avoid in shared shells):
# AST_INSTITUTION_SECRETS_JSON=[{"institutionId":"BANK01","displayName":"Example Bank","token":"replace-me-long-secret","allowlisted":true}]
# NODE_ENV=production
