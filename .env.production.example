# Production secrets — copy to .env.production (never commit real values)
#   cp .env.production.example .env.production
#   # or: npm run cutover:env
#   npm run cutover:preflight
#   docker compose -f docker-compose.prod.yml --env-file .env.production up --build -d
#
# Block E cutover docs: docs/cutover/BLOCK-E.md

AST_IMAGE_TAG=1.1.0
NODE_ENV=production
AST_LOG_JSON=1

# Core
AST_JOURNAL_ENGINE=file
AST_KEY_PROVIDER=file
KILL_SWITCH=false
AST_REQUIRE_INSTITUTION_AUTH=1
# Shared secret portal→core (must match an institution token or dedicated core secret)
AST_INSTITUTION_TOKEN=change-me-core-shared-secret

# Portal institutions (JSON array) — REQUIRED for real login
# Prefer generating via: bash scripts/setup-institution-secrets.sh && npm run cutover:env
AST_INSTITUTION_SECRETS_JSON=[{"institutionId":"YOURBANK","displayName":"Your Bank","token":"change-me-long-random-token","allowlisted":true}]

# Never enable in production public deploy:
AST_ALLOW_DEMO=0

# E1 — public hostname (no scheme)
# AST_PUBLIC_HOST=ast.example.com
# Browser → edge (empty = same-origin rewrites if UI proxies /v1)
NEXT_PUBLIC_PORTAL_API_URL=http://YOUR_HOST:3100

# E3 — optional data plane (not SoT)
# DATABASE_URL=postgres://ast:SECRET@postgres:5432/ast_index
# REDIS_URL=redis://redis:6379
# AST_EVENT_OUT_URL=https://hooks.example.com/ast
# AST_EVENT_OUT_KAFKA_BROKERS=kafka:9092
# AST_EVENT_OUT_KAFKA_TOPIC=ast.journal.events

# E1 TLS / tunnel (home path)
# AST_TLS_EMAIL=admin@example.com
# AST_TUNNEL_EXTRA_HOSTS=www.ast.example.com

# Publish ports (compose)
CORE_PUBLISH_PORT=3000
PORTAL_EDGE_PUBLISH_PORT=3100
PORTAL_UI_PUBLISH_PORT=3200

# X.509 trust (D4) — production roots, not demo CA alone
# AST_X509_TRUST_DIR=/secrets/x509-trust
# AST_REQUIRE_X509=0
