# AST runtime (copy to .env — never commit secrets)

# Journal
AST_JOURNAL_ENGINE=rocksdb
AST_JOURNAL_DIR=data/journal-rocks
AST_VERIFY_EVERY_N=5
# Encryption at rest for file/rocksdb (default on). Key: env or <dir>/at-rest.key
AST_JOURNAL_ENCRYPT=1
# AST_JOURNAL_AT_REST_KEY= # 64 hex chars; omit to auto-create at-rest.key in journal dir

# Kill-switch (set true for read-only)
KILL_SWITCH=false

# HTTP core (when enabled)
PORT=3000
NODE_ENV=local

# Institutional Portal edge
PORTAL_PORT=3100
NEXT_PUBLIC_PORTAL_API_URL=http://localhost:3100
# Portal → Core Orchestrator API
CORE_API_URL=http://localhost:3000
PORTAL_CORE_HANDOFF=true

# Release Phase (config-only thresholds)
RELEASE_THRESHOLD=0
RELEASE_TARGET=0

# Keys: memory | file | hsm (prod: hsm)
AST_KEY_PROVIDER=file
# AST_HSM_MASTER_KEY= # 64 hex chars for soft-HSM

# L3 LLM panel (optional; default policy agents)
# AST_L3_USE_LLM=0
# AST_L3_LLM_PROVIDER=mock
# AST_L3_LLM_BASE_URL=
# AST_L3_LLM_API_KEY=
# AST_L3_LLM_MODEL=

# Institution auth
# Production: AST_REQUIRE_INSTITUTION_AUTH=1, AST_ALLOW_DEMO=0, AST_INSTITUTION_SECRETS_JSON=[...]
# Local demo only: AST_ALLOW_DEMO=1
AST_ALLOW_DEMO=1

# NodeChain Core HTTP read scope (B3)
# AST_OPS_READ_TOKEN=          # X-Ops-Token for full journal read
AST_NODECHAIN_PUBLIC_READ=1    # 0 = anonymous only sees system rows / no foreign processes

# Observer event stream (B4) — default: <AST_JOURNAL_DIR>/observer-events.jsonl
# AST_EVENT_STREAM_PATH=data/journal/observer-events.jsonl
# AST_EVENT_STREAM_PATH=memory   # disable durable file
# AST_REQUIRE_INSTITUTION_AUTH=0
# AST_INSTITUTION_TOKEN=
# AST_INSTITUTION_SECRETS_JSON=[{"institutionId":"YOURBANK","displayName":"Your Bank","token":"secret","allowlisted":true}]


# Postgres index mirror (B6 — not SoT). Omit → MemoryIndexMirror.
# docker compose --profile with-postgres up -d postgres
DATABASE_URL=postgres://ast:ast@127.0.0.1:5432/ast_index

